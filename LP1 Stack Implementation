#include<stdio.h>
#include<conio.h>
#define Max_size 10
int TOP=-1;
int stack[Max_size];
void push(int val){
    if(TOP==Max_size-1){
        printf("stack overflow\n");
    }
    else{
        stack[++TOP]=val;
    }

}
void pop(){
   if(TOP==-1){
        printf("stack underflow\n");
    }
    else{
      TOP--;
    }
}
void top(){
    if(TOP==-1){
        printf("stack underflow\n");
    }
    else{
        printf("%d",stack[TOP]);
    }
}

void display(){
    if(TOP==-1){
        printf("stack is empty\n");
    }
 for(int i=0;i<TOP+1 ,;i++){
    printf("%d\t",stack[i]);
 }
}

